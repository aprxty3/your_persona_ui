# Browser-facing API path (FE-03) — same-origin, proxied by next.config.mjs's
# rewrites() to API_INTERNAL_URL below. Leave as /api/be in every environment
# (dev/staging/prod) so session_id/csrf_token cookies stay first-party — this
# is what makes staging behave the same as local instead of needing
# SameSite=None or a real shared domain. Only override this to call the BE
# directly (bypassing the proxy), which reintroduces the cross-site cookie
# problem outside localhost.
NEXT_PUBLIC_API_BASE_URL=/api/be

# Server-only (never sent to the browser): where the Next.js server actually
# reaches controller-api from. Local dev: the API runs on :8080. Also used
# directly by app/api/og/route.tsx (server-to-server, no cookies involved).
API_INTERNAL_URL=http://localhost:8080

# Cloudflare Turnstile SITE key (not a secret!). The value below is Cloudflare's
# official test sitekey that ALWAYS passes — used in dev so the FE flow is
# identical to production (Tech Doc §5.3). Production: replace with the real sitekey.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# PostHog (Tech Doc §8) — leave empty in dev if you don't want to send events.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
